import { useState } from 'react';
import { useNavigate, useParams } from 'react-router-dom';
import { use{Entity} } from '../hooks/use{Entity}';
import { use{Entity}Mutations } from '../hooks/use{Entity}Mutations';
import { StatusBadge } from '@/shared/components/ui/StatusBadge';
import { LoadingSpinner } from '@/shared/components/ui/LoadingSpinner';
import { ConfirmDialog } from '@/shared/components/ui/ConfirmDialog';

/**
 * {Entity} detail page template.
 *
 * Patterns applied (from DESIGN.md):
 * - Header with title, status badge, and action buttons
 * - Summary cards row for key metrics
 * - Tabbed content sections
 * - Related activity/history logs
 * - Confirm dialog for destructive actions
 */

type Tab = 'overview' | 'documents' | 'history';
// TODO: Extend tabs as needed for this entity

export function {Entity}Detail() {
  const navigate = useNavigate();
  const { id } = useParams<{ id: string }>();
  const [activeTab, setActiveTab] = useState<Tab>('overview');
  const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);

  // --- Data ---
  const { data, isLoading, isError, error, refetch } = use{Entity}(Number(id));
  const { deleteMutation } = use{Entity}Mutations();

  const {entity} = data?.data;

  // --- Handlers ---
  const handleDelete = async () => {
    if (!id) return;
    await deleteMutation.mutateAsync(Number(id));
    navigate('/app/{entities}');
  };

  // --- States ---
  if (isLoading) return <LoadingSpinner />;

  if (isError) {
    return (
      <div className="error-state" role="alert">
        <p>Failed to load {entity}: {error?.message}</p>
        <button onClick={() => refetch()} className="btn btn-secondary">
          Retry
        </button>
      </div>
    );
  }

  if (!{entity}) return null;

  // --- Render ---
  return (
    <div className="{entity}-detail-page">
      {/* Detail Header */}
      <div className="detail-header">
        <div className="detail-header-info">
          <h1>{/* TODO: Entity display name */}{entity}.id</h1>
          <StatusBadge status={{entity}.status} />
        </div>
        <div className="detail-header-actions">
          <button
            className="btn btn-secondary"
            onClick={() => navigate(`/app/{entities}/${id}/edit`)}
          >
            Edit
          </button>
          <button
            className="btn btn-danger"
            onClick={() => setShowDeleteConfirm(true)}
          >
            Delete
          </button>
        </div>
      </div>

      {/* Summary Cards */}
      <div className="summary-cards-row">
        {/* TODO: Add KPI/summary cards for this entity */}
        {/*
        <div className="summary-card">
          <span className="summary-card-label">Status</span>
          <span className="summary-card-value">{entity.status}</span>
        </div>
        <div className="summary-card">
          <span className="summary-card-label">Category</span>
          <span className="summary-card-value">{entity.category}</span>
        </div>
        */}
      </div>

      {/* Tabs */}
      <div className="tabs" role="tablist">
        {(['overview', 'documents', 'history'] as Tab[]).map((tab) => (
          <button
            key={tab}
            role="tab"
            aria-selected={activeTab === tab}
            className={`tab ${activeTab === tab ? 'tab-active' : ''}`}
            onClick={() => setActiveTab(tab)}
          >
            {tab.charAt(0).toUpperCase() + tab.slice(1)}
          </button>
        ))}
      </div>

      {/* Tab Content */}
      <div className="tab-content" role="tabpanel">
        {activeTab === 'overview' && (
          <div className="tab-panel-overview">
            {/* TODO: Render entity details */}
          </div>
        )}

        {activeTab === 'documents' && (
          <div className="tab-panel-documents">
            {/* TODO: Render related documents list */}
          </div>
        )}

        {activeTab === 'history' && (
          <div className="tab-panel-history">
            {/* TODO: Render audit log / activity history */}
          </div>
        )}
      </div>

      {/* Delete Confirmation */}
      <ConfirmDialog
        open={showDeleteConfirm}
        title="Delete {Entity}"
        message="Are you sure you want to delete this {entity}? This action cannot be undone."
        confirmLabel="Delete"
        onConfirm={handleDelete}
        onCancel={() => setShowDeleteConfirm(false)}
        isLoading={deleteMutation.isPending}
      />
    </div>
  );
}
