<?php

namespace App\Domain\{Entity}\Services;

use App\Domain\{Entity}\Models\{Entity};
use App\Domain\{Entity}\Events\{Entity}Created;
use App\Domain\{Entity}\Events\{Entity}Updated;
use App\Domain\{Entity}\Events\{Entity}Deleted;
use Illuminate\Contracts\Pagination\LengthAwarePaginator;
use Illuminate\Support\Facades\DB;

class {Entity}Service
{
    /**
     * List {entities} with filtering and pagination.
     *
     * @param array<string, mixed> $filters
     */
    public function list(array $filters = []): LengthAwarePaginator
    {
        $query = {Entity}::query();

        // Apply filters
        if (!empty($filters['search'])) {
            $query->where(function ($q) use ($filters) {
                // TODO: Add searchable columns
                // $q->where('name', 'ilike', "%{$filters['search']}%");
            });
        }

        if (!empty($filters['status'])) {
            $query->where('status', $filters['status']);
        }

        // Apply sorting
        $sortBy = $filters['sort_by'] ?? 'created_at';
        $sortDir = $filters['sort_dir'] ?? 'desc';
        $query->orderBy($sortBy, $sortDir);

        return $query->paginate($filters['per_page'] ?? 15);
    }

    /**
     * Create a new {entity}.
     *
     * @param array<string, mixed> $data
     */
    public function create(array $data): {Entity}
    {
        return DB::transaction(function () use ($data) {
            // TODO: Add pre-condition checks (compliance, eligibility, etc.)

            ${entity} = {Entity}::create($data);

            event(new {Entity}Created(${entity}));

            return ${entity};
        });
    }

    /**
     * Get a single {entity} with its relations loaded.
     */
    public function getWithRelations({Entity} ${entity}): {Entity}
    {
        return ${entity}->load([
            // TODO: Add eager-loaded relationships
        ]);
    }

    /**
     * Update an existing {entity}.
     *
     * @param array<string, mixed> $data
     */
    public function update({Entity} ${entity}, array $data): {Entity}
    {
        return DB::transaction(function () use (${entity}, $data) {
            $oldValues = ${entity}->getOriginal();

            ${entity}->update($data);

            event(new {Entity}Updated(${entity}, $oldValues));

            return ${entity}->fresh();
        });
    }

    /**
     * Delete an {entity}.
     */
    public function delete({Entity} ${entity}): void
    {
        DB::transaction(function () use (${entity}) {
            // TODO: Add pre-condition checks (cannot delete if in active use)

            event(new {Entity}Deleted(${entity}));

            ${entity}->delete();
        });
    }
}
